.env
.env.*
!.env.example

# WordPress runtime data is persisted by Docker volumes.
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/

# OS/editor noise.
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code local harness state (but keep version-controlled commands/skills).
.claude/*
!.claude/commands/
!.claude/skills/

# Local verification artifacts.
coverage/
dist/
build/
node_modules/
.replica-backups/

# Secrets MUST NEVER be committed — they live only in Coolify env.
# Service-account keys, tokens, and any credential JSON/PEM.
*.pem
*.key
*-service-account*.json
*serviceaccount*.json
*-iam-*.json
# Google Cloud service-account keys are named <project>-<hex>.json.
n8nproject-*.json
scripts/*credential*.json
scripts/*secret*.json
