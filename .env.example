SITE_URL=https://health.ibnbatoutaweb.com
SITE_EMAIL=contact@health.ibnbatoutaweb.com
WRITER_EMAIL=editor@health.ibnbatoutaweb.com
WP_LOCALE=en_US
WP_ADMIN_LOCALE=en_US
KEPOLI_AUTOSEED_ENABLE=1
KEPOLI_FORCE_RESEED=0
CANONICAL_REDIRECT_HOSTS=www.health.ibnbatoutaweb.com
PORT=80
SERVICE_FQDN_WORDPRESS_80=https://health.ibnbatoutaweb.com

# Local development only. Coolify must use domain routing to container port 80 instead.
LOCAL_WORDPRESS_PORT=8082

WORDPRESS_DB_NAME=dr_purg_jr
WORDPRESS_DB_USER=dr_purg_jr
WORDPRESS_DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin
WP_ADMIN_EMAIL=contact@health.ibnbatoutaweb.com

# Optional: keep ads paused until Google Privacy & Messaging / your certified CMP is live.
ADSENSE_CLIENT_ID=
ADSENSE_PUB_ID=
ADSENSE_ENABLE=0
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_AFTER_INTRO=
ADSENSE_SLOT_MID_CONTENT=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_BELOW_CONTENT=

# Optional third-party native/display snippets. Use base64-encoded provider code.
DISPLAY_ADS_ENABLE=0
DISPLAY_ADS_PROVIDER=adsterra
DISPLAY_AD_HEADER_BASE64=
DISPLAY_AD_AFTER_INTRO_BASE64=
DISPLAY_AD_READING_OPTION_BASE64=
DISPLAY_AD_MID_CONTENT_BASE64=
DISPLAY_AD_PART_CONTINUE_BASE64=
DISPLAY_AD_BELOW_CONTENT_BASE64=
DISPLAY_AD_CARD_GRID_BASE64=
DISPLAY_AD_SIDEBAR_BASE64=
DISPLAY_AD_STICKY_BOTTOM_BASE64=
DISPLAY_AD_STICKY_BOTTOM_MIN_SECONDS=35
DISPLAY_AD_STICKY_BOTTOM_MIN_SCROLL=30
DISPLAY_AD_STICKY_BOTTOM_COOLDOWN_MINUTES=30

# Optional Ezoic ads.txt manager redirect.
# Ezoic commonly uses account ID 19390, but use the ID shown in your Ezoic dashboard if different.
EZOIC_ADSTXT_ACCOUNT_ID=
EZOIC_ADSTXT_REDIRECT_URL=
EZOIC_PLUGIN_ENABLE=0

# Optional Monetag instant monetization test. Disabled by default.
KT_AD_MODE=baseline
KT_PRELANDER_ENABLE=0
KT_ACTION_AD_MIN_SECONDS=45
KT_ACTION_AD_MIN_SCROLL=35
MONETAG_ENABLE=0
MONETAG_INPAGE_PUSH_BASE64=
MONETAG_VIGNETTE_BASE64=
MONETAG_ONCLICK_BASE64=
MONETAG_PUSH_BASE64=
MONETAG_INPAGE_PUSH_MINUTES=0
MONETAG_VIGNETTE_MINUTES=0
MONETAG_ONCLICK_MINUTES=0
MONETAG_PUSH_MINUTES=0
MONETAG_POST_ONLY=1
MONETAG_INSTALL_CHECK=0
MONETAG_VERIFICATION=
MONETAG_SW_JS_BASE64=

# Optional Google services.
GA_ENABLE=0
GA_MEASUREMENT_ID=
SEARCH_CONSOLE_VERIFICATION=

# Optional lightweight traffic counter. Use a hidden Histats counter and base64-encode the full code.
HISTATS_ENABLE=0
HISTATS_CODE_BASE64=
HISTATS_EXCLUDE_ADMINS=1

# Optional AI repair for author-tools extraction. Keep disabled unless an API key is configured.
AI_EXTRACTION_ENABLE=0
AI_EXTRACTION_PROVIDER=openrouter
AI_EXTRACTION_API_KEY=
AI_EXTRACTION_MODEL=inclusionai/ling-2.6-1t:free
AI_EXTRACTION_TIMEOUT_SECONDS=14
AI_EXTRACTION_MAX_CHARS=9000
AI_EXTRACTION_MAX_TOKENS=1400

# Optional deploy verification. Keep off for normal production pages.
KEPOLI_DEPLOY_FINGERPRINT=0
